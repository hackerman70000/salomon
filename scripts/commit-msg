#!/usr/bin/env bash

commit_msg_file="$1"
commit_msg=$(head -1 "$commit_msg_file")

pattern="^(feat|fix|docs|chore|refactor|test|style|perf|ci|build|revert)(\(.+\))?: .{1,}"

if ! echo "$commit_msg" | grep -Eq "$pattern"; then
    echo "ERROR: Commit message does not follow Conventional Commits format."
    echo ""
    echo "Expected: <type>(<scope>): <description>"
    echo ""
    echo "Types: feat, fix, docs, chore, refactor, test, style, perf, ci, build, revert"
    echo ""
    echo "Examples:"
    echo "  feat: add baseline training config"
    echo "  fix(data): resolve inheritance in config loader"
    echo "  docs: update USAGE with eval_source"
    echo ""
    echo "Got: $commit_msg"
    exit 1
fi
